<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Atlas Weather | Professional Forecast Dashboard</title>
  <style>
    :root {
      --bg: #08131f;
      --bg-2: #0d1b2a;
      --panel: rgba(15, 23, 42, 0.72);
      --panel-2: rgba(18, 32, 52, 0.9);
      --panel-soft: rgba(148, 163, 184, 0.08);
      --border: rgba(148, 163, 184, 0.18);
      --text: #e5edf7;
      --muted: #9bb0c7;
      --muted-2: #7b90ac;
      --accent: #7dd3fc;
      --accent-2: #38bdf8;
      --accent-3: #8b5cf6;
      --success: #34d399;
      --warning: #fbbf24;
      --danger: #fb7185;
      --shadow: 0 18px 50px rgba(2, 6, 23, 0.45);
      --radius: 24px;
      --radius-sm: 16px;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      font-family: Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(56, 189, 248, 0.15), transparent 28%),
        radial-gradient(circle at bottom right, rgba(139, 92, 246, 0.12), transparent 25%),
        linear-gradient(135deg, var(--bg) 0%, var(--bg-2) 100%);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input {
      font: inherit;
    }

    .dashboard {
      width: min(1200px, calc(100% - 28px));
      margin: 0 auto;
      padding: 28px 0 34px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }

    .brand-mark {
      width: 48px;
      height: 48px;
      border-radius: 16px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 45%, var(--accent-3) 100%);
      color: #061521;
      font-size: 1.2rem;
      font-weight: 900;
      box-shadow: 0 12px 28px rgba(56, 189, 248, 0.35);
    }

    .brand-copy h1 {
      margin: 0;
      font-size: clamp(1.1rem, 2vw, 1.4rem);
      letter-spacing: -0.04em;
    }

    .brand-copy p {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 0.82rem;
    }

    .weather-form {
      width: min(780px, 100%);
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }

    .field {
      position: relative;
    }

    .field input {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: rgba(15, 23, 42, 0.75);
      color: var(--text);
      padding: 13px 14px;
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .field input::placeholder {
      color: var(--muted-2);
    }

    .field input:focus {
      border-color: rgba(125, 211, 252, 0.75);
      box-shadow: 0 0 0 4px rgba(125, 211, 252, 0.11);
      transform: translateY(-1px);
    }

    .field--wide {
      grid-column: 1 / -1;
      display: flex;
      gap: 10px;
    }

    .action-btn,
    .primary-btn {
      border: 1px solid transparent;
      border-radius: 14px;
      padding: 12px 16px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
    }

    .primary-btn {
      flex: 1;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
      color: #041722;
      box-shadow: 0 12px 22px rgba(56, 189, 248, 0.25);
    }

    .action-btn {
      background: rgba(15, 23, 42, 0.75);
      color: var(--text);
      border-color: var(--border);
    }

    .primary-btn:hover,
    .action-btn:hover {
      transform: translateY(-1px);
      filter: brightness(1.04);
    }

    .status {
      min-height: 23px;
      margin: 0 0 16px;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .status.error {
      color: #fca5a5;
    }

    .main-grid {
      display: grid;
      grid-template-columns: 1.6fr 0.9fr;
      gap: 18px;
      margin-top: 8px;
    }

    .card {
      background: rgba(15, 23, 42, 0.72);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      backdrop-filter: blur(16px);
    }

    .current-card {
      position: relative;
      overflow: hidden;
      padding: 28px;
      min-height: 350px;
      background:
        linear-gradient(135deg, rgba(15, 23, 42, 0.88), rgba(15, 23, 42, 0.7)),
        radial-gradient(circle at 80% 15%, rgba(125, 211, 252, 0.16), transparent 28%),
        radial-gradient(circle at 15% 100%, rgba(139, 92, 246, 0.14), transparent 26%);
    }

    .current-card::after {
      content: "";
      position: absolute;
      right: -110px;
      bottom: -120px;
      width: 290px;
      height: 290px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.06);
      box-shadow: 0 0 0 28px rgba(255,255,255,0.012), 0 0 0 56px rgba(255,255,255,0.009);
      pointer-events: none;
    }

    .current-content {
      position: relative;
      z-index: 1;
    }

    .eyebrow {
      margin: 0 0 6px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.72rem;
      font-weight: 700;
    }

    .city-name {
      font-size: clamp(1.8rem, 3.5vw, 2.7rem);
      line-height: 1.05;
      letter-spacing: -0.06em;
      margin: 0;
      font-weight: 800;
    }

    .local-time {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .current-weather {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 26px 0 28px;
      gap: 18px;
    }

    .temperature-wrap {
      min-width: 0;
    }

    .temperature {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-weight: 300;
      font-size: clamp(4.5rem, 9vw, 6.8rem);
      line-height: 0.9;
      letter-spacing: -0.08em;
    }

    .temperature .degree {
      font-size: 1.7rem;
      margin-top: 10px;
      letter-spacing: 0;
    }

    .condition {
      margin: 10px 0 0;
      color: var(--muted);
      font-size: 1rem;
    }

    .weather-emoji {
      font-size: clamp(4.5rem, 8vw, 7rem);
      filter: drop-shadow(0 8px 24px rgba(56, 189, 248, 0.25));
      line-height: 1;
      user-select: none;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }

    .stat-box {
      background: rgba(15, 23, 42, 0.5);
      border: 1px solid rgba(148, 163, 184, 0.12);
      border-radius: 16px;
      padding: 12px 12px 14px;
    }

    .stat-label {
      color: var(--muted);
      font-size: 0.72rem;
      margin-bottom: 9px;
    }

    .stat-value {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -0.03em;
    }

    .side-card {
      padding: 24px 22px;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
    }

    .section-head h2 {
      margin: 0;
      font-size: 1.06rem;
      letter-spacing: -0.03em;
    }

    .pill {
      color: var(--muted);
      font-size: 0.73rem;
      padding: 6px 8px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.06);
      border: 1px solid rgba(148, 163, 184, 0.1);
    }

    .sun-times {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .sun-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 6px;
      border-radius: 12px;
      background: rgba(148, 163, 184, 0.03);
      border: 1px solid rgba(148, 163, 184, 0.04);
    }

    .sun-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: rgba(125, 211, 252, 0.08);
      font-size: 1.2rem;
    }

    .sun-label {
      color: var(--muted);
      font-size: 0.72rem;
      margin-bottom: 3px;
    }

    .sun-value {
      font-weight: 700;
      letter-spacing: -0.03em;
    }

    .uv-box {
      margin-top: 22px;
      padding: 14px 14px 12px;
      border-radius: 14px;
      border: 1px solid rgba(148, 163, 184, 0.11);
      background: rgba(148, 163, 184, 0.04);
    }

    .uv-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      color: var(--muted);
      font-size: 0.82rem;
    }

    .uv-track {
      height: 8px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.1);
      overflow: hidden;
    }

    .uv-fill {
      width: 0%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #6ee7b7, #facc15, #fb7185);
      transition: width 0.3s ease;
    }

    .forecast-card {
      margin-top: 18px;
      padding: 22px 22px 18px;
    }

    .hourly-list {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(88px, 1fr);
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 6px;
      scrollbar-color: #586d87 transparent;
      scrollbar-width: thin;
    }

    .hour-item {
      border: 1px solid rgba(148, 163, 184, 0.1);
      border-radius: 16px;
      background: rgba(148, 163, 184, 0.03);
      padding: 12px 8px;
      text-align: center;
      min-height: 118px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .hour-item .time {
      color: var(--muted);
      font-size: 0.74rem;
    }

    .hour-item .icon {
      font-size: 1.5rem;
      line-height: 1;
    }

    .hour-item .temp {
      font-weight: 700;
      letter-spacing: -0.03em;
    }

    .hour-item .rain {
      color: var(--muted);
      font-size: 0.72rem;
    }

    .forecast-grid {
      display: grid;
      gap: 10px;
    }

    .day-row {
      display: grid;
      grid-template-columns: minmax(90px, 1fr) 40px minmax(80px, 1.4fr) 82px;
      align-items: center;
      gap: 12px;
      border-radius: 14px;
      background: rgba(148, 163, 184, 0.03);
      border: 1px solid rgba(148, 163, 184, 0.08);
      padding: 10px 12px;
    }

    .day-name {
      font-weight: 700;
      letter-spacing: -0.03em;
    }

    .day-icon {
      text-align: center;
      font-size: 1.25rem;
    }

    .day-condition {
      color: var(--muted);
      font-size: 0.8rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .day-temps {
      text-align: right;
      font-weight: 700;
      letter-spacing: -0.03em;
    }

    .day-temps .low {
      color: var(--muted);
      font-weight: 600;
      margin-left: 6px;
    }

    .footer {
      margin-top: 16px;
      color: var(--muted);
      text-align: center;
      font-size: 0.8rem;
      padding: 8px 0 0;
    }

    .footer a {
      color: var(--accent);
    }

    .loading .weather-emoji {
      animation: pulse 1s ease-in-out infinite alternate;
    }

    @keyframes pulse {
      from { transform: scale(1); opacity: 1; }
      to { transform: scale(0.94); opacity: 0.55; }
    }

    @media (max-width: 980px) {
      .topbar {
        flex-direction: column;
        align-items: stretch;
      }

      .weather-form {
        width: 100%;
      }

      .main-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 620px) {
      .dashboard {
        width: min(100% - 18px, 1160px);
      }

      .weather-form {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .field--wide {
        grid-column: 1 / -1;
      }

      .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .current-card, .side-card, .forecast-card {
        padding-left: 18px;
        padding-right: 18px;
      }
    }

    @media (max-width: 440px) {
      .weather-form {
        grid-template-columns: 1fr;
      }

      .field--wide {
        display: block;
      }

      .field--wide .primary-btn,
      .field--wide .action-btn {
        width: 100%;
      }

      .field--wide .action-btn {
        margin-top: 10px;
      }

      .current-weather {
        flex-direction: column;
        align-items: flex-start;
      }

      .weather-emoji {
        align-self: flex-end;
      }

      .day-row {
        grid-template-columns: minmax(72px, 1fr) 32px minmax(54px, 1fr) 62px;
        gap: 8px;
      }
    }
  </style>
</head>
<body>
  <main class="dashboard">
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">☀</div>
        <div class="brand-copy">
          <h1>Atlas Weather</h1>
          <p>Professional local forecast dashboard</p>
        </div>
      </div>

      <form id="searchForm" class="weather-form" aria-label="Weather search">
        <label class="field">
          <input id="countryInput" type="text" value="Rwanda" placeholder="Country" aria-label="Country" />
        </label>
        <label class="field">
          <input id="districtInput" type="text" placeholder="District / city" aria-label="District or city" required />
        </label>
        <label class="field">
          <input id="sectorInput" type="text" placeholder="Sector" aria-label="Sector" />
        </label>

        <label class="field">
          <input id="cellInput" type="text" placeholder="Cell" aria-label="Cell" />
        </label>
        <label class="field">
          <input id="villageInput" type="text" placeholder="Village" aria-label="Village" />
        </label>

        <div class="field field--wide">
          <button class="primary-btn" type="submit">Search forecast</button>
          <button class="action-btn" id="locationButton" type="button" aria-label="Use current location">
            My location
          </button>
        </div>
      </form>
    </header>

    <p id="status" class="status" role="status" aria-live="polite"></p>

    <div class="main-grid">
      <section class="card current-card" aria-label="Current weather">
        <div class="current-content">
          <p class="eyebrow">Current conditions</p>
          <h2 id="cityName" class="city-name">Loading weather…</h2>
          <p id="localTime" class="local-time">—</p>

          <div class="current-weather">
            <div class="temperature-wrap">
              <div class="temperature">
                <span id="temperature">--</span>
                <span class="degree">°</span>
              </div>
              <p id="condition" class="condition">Fetching current conditions</p>
            </div>

            <div id="weatherIcon" class="weather-emoji" aria-label="Weather icon">🌤️</div>
          </div>

          <div class="stats-grid">
            <div class="stat-box">
              <div class="stat-label">Feels like</div>
              <div id="feelsLike" class="stat-value">—</div>
            </div>
            <div class="stat-box">
              <div class="stat-label">Humidity</div>
              <div id="humidity" class="stat-value">—</div>
            </div>
            <div class="stat-box">
              <div class="stat-label">Wind</div>
              <div id="wind" class="stat-value">—</div>
            </div>
            <div class="stat-box">
              <div class="stat-label">Rain</div>
              <div id="precipitation" class="stat-value">—</div>
            </div>
          </div>
        </div>
      </section>

      <aside class="card side-card" aria-label="Sunrise, sunset, and UV information">
        <div class="section-head">
          <h2>Sun &amp; UV</h2>
          <span class="pill">Today</span>
        </div>

        <div class="sun-times">
          <div class="sun-row">
            <div class="sun-icon" aria-hidden="true">🌅</div>
            <div>
              <div class="sun-label">Sunrise</div>
              <div id="sunrise" class="sun-value">—</div>
            </div>
          </div>

          <div class="sun-row">
            <div class="sun-icon" aria-hidden="true">🌇</div>
            <div>
              <div class="sun-label">Sunset</div>
              <div id="sunset" class="sun-value">—</div>
            </div>
          </div>
        </div>

        <div class="uv-box">
          <div class="uv-top">
            <span>UV index</span>
            <strong id="uvValue">—</strong>
          </div>
          <div class="uv-track" aria-label="UV index">
            <div id="uvFill" class="uv-fill"></div>
          </div>
        </div>
      </aside>
    </div>

    <section class="card forecast-card" aria-label="Hourly forecast">
      <div class="section-head">
        <h2>Hourly forecast</h2>
        <span class="pill">Next 24 hours</span>
      </div>
      <div id="hourlyForecast" class="hourly-list"></div>
    </section>

    <section class="card forecast-card" aria-label="7-day forecast">
      <div class="section-head">
        <h2>7-day forecast</h2>
        <span class="pill">Long range</span>
      </div>
      <div id="dailyForecast" class="forecast-grid"></div>
    </section>

    <footer class="footer">
      Weather data from
      <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo</a>
      · Location lookup from
      <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a>
    </footer>
  </main>

  <script>
    const $ = (id) => document.getElementById(id);

    const weatherDescriptions = {
      0: ["Clear sky", "☀️"],
      1: ["Mainly clear", "🌤️"],
      2: ["Partly cloudy", "⛅"],
      3: ["Overcast", "☁️"],
      45: ["Fog", "🌫️"],
      48: ["Rime fog", "🌫️"],
      51: ["Light drizzle", "🌦️"],
      53: ["Moderate drizzle", "🌦️"],
      55: ["Dense drizzle", "🌧️"],
      56: ["Light freezing drizzle", "🌧️"],
      57: ["Dense freezing drizzle", "🌧️"],
      61: ["Slight rain", "🌦️"],
      63: ["Moderate rain", "🌧️"],
      65: ["Heavy rain", "🌧️"],
      66: ["Light freezing rain", "🌧️"],
      67: ["Heavy freezing rain", "🌧️"],
      71: ["Slight snow", "🌨️"],
      73: ["Moderate snow", "🌨️"],
      75: ["Heavy snow", "❄️"],
      77: ["Snow grains", "🌨️"],
      80: ["Light showers", "🌦️"],
      81: ["Moderate showers", "🌧️"],
      82: ["Heavy showers", "⛈️"],
      85: ["Light snow showers", "🌨️"],
      86: ["Heavy snow showers", "❄️"],
      95: ["Thunderstorm", "⛈️"],
      96: ["Thunderstorm with hail", "⛈️"],
      99: ["Severe thunderstorm", "⛈️"]
    };

    function describeWeather(code) {
      return weatherDescriptions[code] || ["Unknown", "🌡️"];
    }

    function setStatus(message = "", isError = false) {
      const statusEl = $("status");
      statusEl.textContent = message;
      statusEl.classList.toggle("error", isError);
    }

    function formatClock(dateTime, timeZone) {
      return new Intl.DateTimeFormat(undefined, {
        hour: "numeric",
        minute: "2-digit",
        timeZone
      }).format(new Date(dateTime));
    }

    function formatLocalDate(dateTime, timeZone) {
      return new Intl.DateTimeFormat(undefined, {
        weekday: "long",
        month: "long",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
        timeZone
      }).format(new Date(dateTime));
    }

    function formatDay(dateString, index) {
      if (index === 0) return "Today";
      if (index === 1) return "Tomorrow";
      return new Intl.DateTimeFormat(undefined, { weekday: "short" }).format(new Date(`${dateString}T12:00:00`));
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[char]);
    }

    async function getLocationCoordinates(query) {
      const url = new URL("https://nominatim.openstreetmap.org/search");
      url.search = new URLSearchParams({
        q: query,
        format: "jsonv2",
        addressdetails: "1",
        limit: "1"
      });

      const response = await fetch(url, {
        headers: {
          "Accept": "application/json",
          "User-Agent": "AtlasWeatherApp/1.0"
        }
      });

      if (!response.ok) {
        throw new Error("Location lookup is temporarily unavailable.");
      }

      const results = await response.json();
      const result = results[0];

      if (!result) {
        throw new Error(`No location matched "${query}". Try a broader district or city name.`);
      }

      return {
        name: result.display_name,
        latitude: Number(result.lat),
        longitude: Number(result.lon)
      };
    }

    function buildLocationQuery() {
      return [
        $("villageInput").value.trim(),
        $("cellInput").value.trim(),
        $("sectorInput").value.trim(),
        $("districtInput").value.trim(),
        $("countryInput").value.trim()
      ].filter(Boolean).join(", ");
    }

    async function getWeather(latitude, longitude) {
      const url = new URL("https://api.open-meteo.com/v1/forecast");
      url.search = new URLSearchParams({
        latitude: String(latitude),
        longitude: String(longitude),
        current: [
          "temperature_2m",
          "relative_humidity_2m",
          "apparent_temperature",
          "precipitation",
          "weather_code",
          "wind_speed_10m"
        ].join(","),
        hourly: [
          "temperature_2m",
          "precipitation_probability",
          "weather_code"
        ].join(","),
        daily: [
          "weather_code",
          "temperature_2m_max",
          "temperature_2m_min",
          "sunrise",
          "sunset",
          "uv_index_max"
        ].join(","),
        timezone: "auto",
        forecast_days: "7"
      });

      const res = await fetch(url);
      if (!res.ok) throw new Error("Weather data is temporarily unavailable.");
      return res.json();
    }

    function renderHourly(data) {
      const hourly = data.hourly;
      const currentTime = data.current.time;
      let startIndex = hourly.time.findIndex((time) => time >= currentTime);
      if (startIndex < 0) startIndex = 0;

      $("hourlyForecast").innerHTML = hourly.time
        .slice(startIndex, startIndex + 24)
        .map((time, offset) => {
          const index = startIndex + offset;
          const [description, icon] = describeWeather(hourly.weather_code[index]);
          const label = offset === 0 ? "Now" : formatClock(time, data.timezone);
          const rainChance = hourly.precipitation_probability[index] ?? 0;

          return `
            <div class="hour-item" title="${escapeHtml(description)}">
              <span class="time">${escapeHtml(label)}</span>
              <span class="icon" aria-hidden="true">${icon}</span>
              <span class="temp">${Math.round(hourly.temperature_2m[index])}°</span>
              <span class="rain">💧 ${rainChance}%</span>
            </div>
          `;
        })
        .join("");
    }

    function renderDaily(data) {
      const daily = data.daily;

      $("dailyForecast").innerHTML = daily.time.map((date, index) => {
        const [description, icon] = describeWeather(daily.weather_code[index]);

        return `
          <div class="day-row" title="${escapeHtml(description)}">
            <span class="day-name">${formatDay(date, index)}</span>
            <span class="day-icon" aria-hidden="true">${icon}</span>
            <span class="day-condition">${escapeHtml(description)}</span>
            <span class="day-temps">
              ${Math.round(daily.temperature_2m_max[index])}°
              <span class="low">${Math.round(daily.temperature_2m_min[index])}°</span>
            </span>
          </div>
        `;
      }).join("");
    }

    function renderWeather(place, data) {
      const current = data.current;
      const [description, icon] = describeWeather(current.weather_code);
      const daily = data.daily;
      const uv = daily.uv_index_max[0] ?? 0;

      $("cityName").textContent = place.name;
      $("localTime").textContent = formatLocalDate(current.time, data.timezone);
      $("temperature").textContent = Math.round(current.temperature_2m);
      $("condition").textContent = description;
      $("feelsLike").textContent = `${Math.round(current.apparent_temperature)}°`;
      $("humidity").textContent = `${current.relative_humidity_2m}%`;
      $("wind").textContent = `${Math.round(current.wind_speed_10m)} km/h`;
      $("precipitation").textContent = `${current.precipitation} mm`;
      $("weatherIcon").textContent = icon;

      $("sunrise").textContent = formatClock(daily.sunrise[0], data.timezone);
      $("sunset").textContent = formatClock(daily.sunset[0], data.timezone);

      const uvText = uv <= 2 ? "Low" : uv <= 5 ? "Moderate" : uv <= 7 ? "High" : "Very high";
      $("uvValue").textContent = `${uv} · ${uvText}`;
      $("uvFill").style.width = `${Math.min(100, (uv / 11) * 100)}%`;

      renderHourly(data);
      renderDaily(data);
    }

    async function loadWeather(place) {
      document.body.classList.add("loading");
      setStatus(`Loading weather for ${place.name}…`);

      try {
        const data = await getWeather(place.latitude, place.longitude);
        renderWeather(place, data);
        setStatus(`Showing live forecast for ${place.name}.`);
      } catch (error) {
        setStatus(error.message || "Unable to load weather. Please try again.", true);
      } finally {
        document.body.classList.remove("loading");
      }
    }

    $("searchForm").addEventListener("submit", async (event) => {
      event.preventDefault();

      const query = buildLocationQuery();
      if (!query) {
        setStatus("Please enter a district or city to search.", true);
        return;
      }

      setStatus(`Searching for ${query}…`);

      try {
        const place = await getLocationCoordinates(query);
        await loadWeather(place);
      } catch (error) {
        setStatus(error.message || "Could not find that location.", true);
      }
    });

    $("locationButton").addEventListener("click", () => {
      if (!navigator.geolocation) {
        setStatus("Location access is not supported in this browser.", true);
        return;
      }

      setStatus("Getting your current location…");

      navigator.geolocation.getCurrentPosition(
        async ({ coords }) => {
          await loadWeather({
            name: "Your current location",
            latitude: coords.latitude,
            longitude: coords.longitude
          });
        },
        () => {
          setStatus("Location permission was denied or unavailable.", true);
        },
        { enableHighAccuracy: false, timeout: 10000 }
      );
    });

    (async function init() {
      try {
        const defaultLocation = await getLocationCoordinates("Kigali, Rwanda");
        await loadWeather(defaultLocation);
      } catch (error) {
        setStatus(error.message || "Unable to load the default forecast.", true);
      }
    })();
  </script>
</body>
</html>
